{
  "manifest_version": 3,
  "name": "SnippyGrab UI Design",
  "version": "1.0.0",
  "description": "Import the visible page or a selected element as editable SnippyGrab design layers.",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "extension/background.js" },
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "Import UI into SnippyGrab"
  }
}
