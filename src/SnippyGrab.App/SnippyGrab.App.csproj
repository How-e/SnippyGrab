<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>SnippyGrab</AssemblyName>
    <Version>0.1.0-alpha</Version><Product>SnippyGrab</Product><Description>Local Windows screenshot shelf with annotation and OCR</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- WPF owns DPI through its manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\scripts\update-helper.ps1" Link="update-helper.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\SnippyGrab.Core\SnippyGrab.Core.csproj" />
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" />
    <Content Include="tessdata\*.traineddata"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The OCR wrapper uses Assembly.Location; retain it and its native dependencies as sidecars. -->
  <PropertyGroup><SnippyNativeRoot>$(MSBuildThisFileDirectory)..\..\artifacts\native-ocr\current\</SnippyNativeRoot></PropertyGroup>
  <Target Name="BuildPinnedNativeOcr" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\build-native-ocr.ps1&quot;" />
  </Target>
  <PropertyGroup><SnippyWebpRoot>$(MSBuildThisFileDirectory)..\..\artifacts\native-webp\current\</SnippyWebpRoot></PropertyGroup>
  <Target Name="BuildPinnedNativeWebp" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\build-native-webp.ps1&quot;" />
  </Target>
  <Target Name="CopyPinnedNativeWebp" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="$(SnippyWebpRoot)x64\snippywebp.dll" DestinationFolder="$(TargetDir)x64" />
    <Copy SourceFiles="$(SnippyWebpRoot)WEBP-PROVENANCE.json" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="PublishPinnedNativeWebp" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(SnippyWebpRoot)x64\snippywebp.dll"><RelativePath>x64\snippywebp.dll</RelativePath><CopyToPublishDirectory>Always</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(SnippyWebpRoot)WEBP-PROVENANCE.json"><RelativePath>WEBP-PROVENANCE.json</RelativePath><CopyToPublishDirectory>Always</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyPinnedNativeOcr" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup><SnippyNativeFiles Include="$(SnippyNativeRoot)x64\*.dll" /></ItemGroup>
    <Copy SourceFiles="@(SnippyNativeFiles)" DestinationFolder="$(TargetDir)x64" />
    <Copy SourceFiles="$(SnippyNativeRoot)NATIVE-OCR-PROVENANCE.json" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="PublishPinnedNativeOcr" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.FileName)' == 'tesseract50' or '%(ResolvedFileToPublish.FileName)' == 'leptonica-1.82.0'" />
      <SnippyNativePublish Include="$(SnippyNativeRoot)x64\*.dll" />
      <ResolvedFileToPublish Include="@(SnippyNativePublish)"><RelativePath>x64\%(SnippyNativePublish.Filename)%(SnippyNativePublish.Extension)</RelativePath><CopyToPublishDirectory>Always</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(SnippyNativeRoot)NATIVE-OCR-PROVENANCE.json"><RelativePath>NATIVE-OCR-PROVENANCE.json</RelativePath><CopyToPublishDirectory>Always</CopyToPublishDirectory><ExcludeFromSingleFile>true</ExcludeFromSingleFile></ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="KeepOcrSidecars" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(FileName)' == 'Tesseract' or '%(FileName)' == 'tesseract50' or '%(FileName)' == 'leptonica-1.82.0'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
