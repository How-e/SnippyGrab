<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SnippyGrab.App/SnippyGrab.App.csproj" />
    <Content Include="../../src/SnippyGrab.App/tessdata/*.traineddata" Link="tessdata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyPinnedNativeOcrForTests" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup><SnippyNativeFiles Include="../../artifacts/native-ocr/current/x64/*.dll" /></ItemGroup>
    <Copy SourceFiles="@(SnippyNativeFiles)" DestinationFolder="$(TargetDir)x64" />
    <Copy SourceFiles="../../artifacts/native-ocr/current/NATIVE-OCR-PROVENANCE.json" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
